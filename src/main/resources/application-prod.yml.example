# 배포용 프로필 템플릿 — application-prod.yml 로 복사해서 사용 (커밋 금지, .gitignore 대상).
#
# 앱 서버(VM #2)에서 실행되며, DB 와 judge0 는 DB VM(10.0.0.186)에 있다.
# 두 서비스는 grindalgo-tunnel.service(autossh)가 앱 서버의 127.0.0.1 로 포워딩해 주므로
# 여기서는 localhost 로 붙는다. 터널이 죽으면 백엔드도 DB 를 잃으니 상태를 함께 확인할 것:
#   systemctl status grindalgo-tunnel
spring:
  datasource:
    url: jdbc:mariadb://127.0.0.1:3306/example
    username: grind
    password: "VM #1 의 grind 계정 비밀번호"
    driver-class-name: org.mariadb.jdbc.Driver

  # 세션 쿠키 — HTTPS 로만 전송하고 JS 접근을 막는다. 프론트와 같은 오리진이라 Lax 로 충분하다.
  servlet:
    session:
      cookie:
        secure: true
        http-only: true
        same-site: lax
      timeout: 7d

  # 소셜 로그인 — 콜백 주소를 배포 도메인으로 등록해야 한다.
  #   GitHub  https://<도메인>/login/oauth2/code/github
  #   Google  https://<도메인>/login/oauth2/code/google
  security:
    oauth2:
      client:
        registration:
          github:
            client-id: "GitHub OAuth App 의 Client ID"
            client-secret: "GitHub OAuth App 의 Client Secret"
            scope: read:user, user:email
          google:
            client-id: "Google OAuth 클라이언트 ID"
            client-secret: "Google OAuth 클라이언트 시크릿"
            scope: email, profile

judge0:
  client: real
  base-url: http://127.0.0.1:2358
  wait: true
  auth-token: "VM #1 judge0 의 AUTHN_TOKEN 값"

app:
  oauth2:
    success-redirect: "/"     # 프론트와 같은 오리진이라 루트로 보내면 된다

server:
  port: 8080                  # Caddy 가 앞단에서 443 을 받아 이 포트로 넘긴다
  address: 127.0.0.1          # 외부 직접 접근 차단 — 반드시 Caddy 를 거치게 한다
  forward-headers-strategy: native   # X-Forwarded-* 를 신뢰해 https 스킴과 클라이언트 IP 를 인식

logging:
  level:
    root: info
  file:
    name: /var/log/grindalgo/backend.log
