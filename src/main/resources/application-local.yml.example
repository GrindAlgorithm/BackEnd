
# 로컬 개발 프로필 템플릿 — 이 파일을 application-local.yml 로 복사해서 사용.
# application-local.yml 은 .gitignore 대상이라 커밋되지 않는다.
# 값은 docker-compose.yml 의 MariaDB 컨테이너 설정과 일치해야 한다.
spring:
  datasource:
    url: jdbc:mariadb://localhost:13306/example
    username: grind
    password: grind-local
    driver-class-name: org.mariadb.jdbc.Driver

  # ── 소셜 로그인 (OAuth2, 연동 문서 §1.3) ─────────────────────────────────
  # GitHub/Google OAuth 앱을 등록해 client-id/secret 을 발급받아 아래를 활성화한다.
  # 미설정 시 소셜 로그인만 비활성(앱은 정상 기동). 콜백(redirect) URL 은
  #   http://localhost:8080/login/oauth2/code/github
  #   http://localhost:8080/login/oauth2/code/google
  # 을 각 OAuth 앱에 등록할 것. (프론트는 /oauth2/authorization/{provider} 로 진입)
  #
  # GitHub:  https://github.com/settings/developers → New OAuth App
  # Google:  https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID
  #
  # security:
  #   oauth2:
  #     client:
  #       registration:
  #         github:
  #           client-id: "발급받은_GitHub_client_id"
  #           client-secret: "발급받은_GitHub_client_secret"
  #           scope: read:user, user:email
  #         google:
  #           client-id: "발급받은_Google_client_id"
  #           client-secret: "발급받은_Google_client_secret"
  #           scope: email, profile

# 소셜 로그인 성공 후 프론트로 돌아갈 경로 (dev는 프록시라 "/"로 충분)
# app:
#   oauth2:
#     success-redirect: "/"

# Judge0 채점 엔진 (연동 문서 §3, B3 — 클라이언트에 직접 노출 금지)
# client=stub(기본): 실제 Judge0 없이 채점 파이프라인 동작(로컬 시뮬레이션, 진짜 채점 아님)
# client=real: 실제 Judge0로 채점.
judge0:
  client: stub

  # ── (A) 외부 호스팅 Judge0 — RapidAPI Judge0 CE ──────────────────────────
  # RapidAPI(https://rapidapi.com/judge0-official/api/judge0-ce)에서 키를 발급받아 아래를 활성화.
  # 공용 인스턴스는 wait=true 를 막으므로 반드시 wait: false(폴링) 로 둔다.
  # client: real
  # base-url: https://judge0-ce.p.rapidapi.com
  # wait: false
  # headers:
  #   X-RapidAPI-Key: "여기에_RapidAPI_키"
  #   X-RapidAPI-Host: judge0-ce.p.rapidapi.com

  # ── (B) 자체 원격/로컬 Judge0 (docker-compose.judge0.yml) ────────────────
  # self-host 는 wait=true(동기) 가능. isolate 샌드박스는 cgroup v1 호스트 필요.
  # client: real
  # base-url: http://localhost:2358
  # wait: true
  # auth-token: ""          # AUTHN_TOKEN 설정 시
