# Oracle Cloud VM MariaDB 접속 프로필 템플릿 — application-vm.yml 로 복사해서 사용.
# application-vm.yml 은 .gitignore 대상이라 커밋되지 않는다.
#
# VM의 MariaDB는 127.0.0.1:3306 에만 바인딩(외부 미노출) — 접속 전 SSH 터널을 먼저 연다:
#   ssh -i <SSH_개인키> -N -L 13307:127.0.0.1:3306 ubuntu@<VM_공인IP>
# 실행: ./gradlew bootRun --args='--spring.profiles.active=vm'
spring:
  datasource:
    url: jdbc:mariadb://localhost:13307/example
    username: grind
    password: "VM의 grind 계정 비밀번호"
    driver-class-name: org.mariadb.jdbc.Driver

judge0:
  client: stub
