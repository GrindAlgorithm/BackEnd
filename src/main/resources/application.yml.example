# 메인 스프링 설정 템플릿 — 이 파일을 application.yml 로 복사해서 사용.
# application.yml 은 .gitignore 대상이라 커밋되지 않는다.
# DB 접속 정보는 여기에 두지 말고 application-local.yml 에만 둔다 (템플릿: application-local.yml.example).
spring.application.name: springboot

server:
  port: 8080

spring:
  # 프로필 미지정 시 local 사용 — DB 접속 정보는 application-{profile}.yml 에만 둔다 (여기에 두지 말 것)
  profiles:
    default: local
  jpa:
    show-sql: true
    generate-ddl: false
    hibernate.ddl-auto: none
    hibernate:
      naming:
        physical-strategy: org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl

logging:
  level:
    root: info
