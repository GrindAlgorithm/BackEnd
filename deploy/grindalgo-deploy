#!/bin/bash
# 서버 측 배포 스크립트 — deployer 계정이 sudo 로 실행할 수 있는 유일한 명령.
#
#   sudo /usr/local/bin/grindalgo-deploy backend    # /tmp/backend.jar 를 설치하고 재기동
#   sudo /usr/local/bin/grindalgo-deploy frontend   # /tmp/grindalgo-dist.tgz 를 배포
#
# 소유자는 root 이고 deployer 는 쓰기 권한이 없다. 배포에 필요한 동작이 전부 이 안에 있으므로
# sudoers 에는 이 스크립트만 등록하면 되고, sudo mv / sudo systemctl 같은 범용 명령을
# 열어 줄 필요가 없다. CI 키가 유출돼도 공격자가 할 수 있는 일은 "코드를 배포하는 것"뿐이다.

set -euo pipefail

BACKEND_JAR=/opt/grindalgo/backend.jar
PREV_JAR=/opt/grindalgo/backend.prev.jar
STAGED_JAR=/tmp/backend.jar
STAGED_DIST=/tmp/grindalgo-dist.tgz
WEB_ROOT=/var/www/grindalgo

log() { echo "[grindalgo-deploy] $*"; }
die() { echo "[grindalgo-deploy] 오류: $*" >&2; exit 1; }

deploy_backend() {
  [ -f "$STAGED_JAR" ] || die "$STAGED_JAR 가 없습니다. 먼저 업로드하세요."

  # 최소한의 형식 검증 — 잘못된 파일로 서비스를 내리지 않도록.
  [ -s "$STAGED_JAR" ] || die "업로드된 jar 가 비어 있습니다."
  head -c 2 "$STAGED_JAR" | grep -q 'PK' || die "jar 형식이 아닙니다."

  log "이전 버전 보관"
  [ -f "$BACKEND_JAR" ] && cp -f "$BACKEND_JAR" "$PREV_JAR"

  log "설치"
  install -o grindalgo -g grindalgo -m 640 "$STAGED_JAR" "$BACKEND_JAR"
  rm -f "$STAGED_JAR"

  log "재기동"
  systemctl restart grindalgo-backend

  log "기동 확인"
  for _ in $(seq 1 40); do
    if curl -sf -o /dev/null http://127.0.0.1:8080/api/v1/languages; then
      log "정상"
      return 0
    fi
    sleep 3
  done

  # 새 버전이 뜨지 않으면 직전 버전으로 되돌린다 — 배포 실패로 서비스가 멈춰 있지 않게.
  if [ -f "$PREV_JAR" ]; then
    log "기동 실패 — 직전 버전으로 롤백"
    install -o grindalgo -g grindalgo -m 640 "$PREV_JAR" "$BACKEND_JAR"
    systemctl restart grindalgo-backend
  fi
  die "새 버전이 기동하지 않았습니다. journalctl -u grindalgo-backend 를 확인하세요."
}

deploy_frontend() {
  [ -f "$STAGED_DIST" ] || die "$STAGED_DIST 가 없습니다. 먼저 업로드하세요."

  local tmp
  tmp=$(mktemp -d /tmp/grindalgo-dist.XXXXXX)
  trap 'rm -rf "$tmp"' EXIT

  log "압축 해제"
  # --no-same-owner/--no-same-permissions: 아카이브 안의 소유자·권한을 따르지 않는다.
  # tar 는 기본적으로 절대경로와 .. 를 거부하므로 임시 디렉터리 밖으로 나가지 못한다.
  tar --no-same-owner --no-same-permissions -C "$tmp" -xzf "$STAGED_DIST"
  [ -f "$tmp/index.html" ] || die "index.html 이 없습니다. 빌드 산출물이 맞는지 확인하세요."

  log "교체"
  chown -R caddy:caddy "$tmp"
  chmod -R u=rwX,go=rX "$tmp"
  rm -rf "${WEB_ROOT}.old"
  [ -d "$WEB_ROOT" ] && mv "$WEB_ROOT" "${WEB_ROOT}.old"
  mv "$tmp" "$WEB_ROOT"
  trap - EXIT
  rm -f "$STAGED_DIST"

  log "정상"
}

case "${1:-}" in
  backend)  deploy_backend ;;
  frontend) deploy_frontend ;;
  *) die "사용법: grindalgo-deploy {backend|frontend}" ;;
esac
