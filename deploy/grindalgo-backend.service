[Unit]
Description=GrindAlgorithm backend (Spring Boot)
After=network-online.target grindalgo-tunnel.service
Wants=network-online.target
# DB·judge0 가 이 터널 너머에 있다. 터널이 멈추면 백엔드도 함께 멈춘다.
Requires=grindalgo-tunnel.service

[Service]
Type=simple
User=grindalgo
Group=grindalgo
WorkingDirectory=/opt/grindalgo

# 1GB VM 이라 힙을 명시적으로 묶어 둔다. 컨테이너 인식 옵션이 없는 베어메탈 실행이므로
# MaxRAMPercentage 대신 고정 힙을 쓴다. 늘리기 전에 free -m 으로 여유를 먼저 확인할 것.
Environment=JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseSerialGC -XX:MaxMetaspaceSize=192m
Environment=SPRING_PROFILES_ACTIVE=prod

ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/grindalgo/backend.jar

# 기동이 오래 걸려도(1GB 라 30초 이상 걸릴 수 있다) 죽이지 않는다.
TimeoutStartSec=180
Restart=always
RestartSec=10

# OOM 시 커널이 이 프로세스를 먼저 고르게 둔다 — MariaDB·judge0 보다 재기동이 싸다.
OOMScoreAdjust=200

# 최소 권한
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/grindalgo

StandardOutput=journal
StandardError=journal
SyslogIdentifier=grindalgo

[Install]
WantedBy=multi-user.target
